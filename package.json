{
	"name": "obsidian-proton-attachments",
	"version": "0.1.0",
	"description": "Upload heavy files to Proton Drive and insert a secure link with password in your notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
