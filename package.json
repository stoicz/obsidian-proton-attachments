	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.1",
		"obsidian": "^1.5.0",
		"tslib": "^2.7.0",
		"typescript": "^5.6.0"
	}
}